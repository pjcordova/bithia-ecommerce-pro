# Copia este archivo como .env y rellena los valores.
# .env está en .gitignore — nunca se sube al repositorio.

# --- Base de datos (Railway) -------------------------------------------
DATABASE_URL=""

# --- Sesión del panel (login de perfiles) -------------------------------
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Integración con bithia-web (descuento automático de stock) --------
# API key compartida: bithia-web la manda en el header Authorization al
# llamar POST /api/pedidos/descontar-stock. Debe ser el mismo valor que
# ERP_STOCK_API_KEY en el .env de bithia-web. Generar igual que arriba.
# Ver docs/integracion-erp-stock.md (repo bithia-web) para el contrato
# completo del endpoint.
ERP_STOCK_API_KEY=""
